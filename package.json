{
  "name": "@bridge/ui",
  "version": "0.1.0",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": {
      "types": "./dist/style.css.d.ts",
      "default": "./dist/style.css"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "catalog:build": "vite build --config vite.config.ts",
    "catalog:test": "playwright test --config playwright.config.ts",
    "boundary": "bun internal/script/check-source-boundary.ts",
    "build": "bun internal/script/build-package.ts",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "test": "bun test",
    "typecheck": "bunx --bun tsgo --noEmit",
    "verify:package": "bun internal/script/verify-package.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/sarabun": "^5.3.0",
    "@shadcn/react": "^0.3.1",
    "@tanstack/charts": "0.16.0",
    "@tanstack/react-charts": "0.16.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.5",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1",
    "next-themes": "^0.4.6",
    "react-day-picker": "^10.0.1",
    "react-resizable-panels": "^4.12.3",
    "recharts": "3.8.0",
    "sonner": "^2.0.7",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@effect/language-service": "^0.87.2",
    "@effect/tsgo": "^0.41.0",
    "@effect/vitest": "^0.30.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "latest",
    "@types/node": "^26.4.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-plugin-tailwind": "^0.1.2",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "playwright": "^1.55.0",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  }
}
