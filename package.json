{
  "name": "@bridge/ui",
  "version": "0.3.0",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    "./upload-viewer": {
      "types": "./dist/component/brand/stylex/upload-viewer.d.ts",
      "import": "./dist/component/brand/stylex/upload-viewer.js"
    },
    "./upload-list": {
      "types": "./dist/component/brand/stylex/upload-list.d.ts",
      "import": "./dist/component/brand/stylex/upload-list.js"
    },
    "./image-crop": {
      "types": "./dist/component/brand/stylex/image-crop.d.ts",
      "import": "./dist/component/brand/stylex/image-crop.js"
    },
    "./upload-preview": {
      "types": "./dist/component/brand/stylex/upload-preview.d.ts",
      "import": "./dist/component/brand/stylex/upload-preview.js"
    },
    "./button": {
      "types": "./dist/component/brand/stylex/button.d.ts",
      "import": "./dist/component/brand/stylex/button.js"
    },
    "./data-state": {
      "types": "./dist/component/brand/stylex/data-state.d.ts",
      "import": "./dist/component/brand/stylex/data-state.js"
    },
    "./page": {
      "types": "./dist/component/brand/stylex/page.d.ts",
      "import": "./dist/component/brand/stylex/page.js"
    },
    "./table-frame": {
      "types": "./dist/component/brand/stylex/table-frame.d.ts",
      "import": "./dist/component/brand/stylex/table-frame.js"
    },
    "./timeline-step": {
      "types": "./dist/component/brand/stylex/timeline-step.d.ts",
      "import": "./dist/component/brand/stylex/timeline-step.js"
    },
    "./ts-chart": {
      "types": "./dist/component/brand/ts-chart.d.ts",
      "import": "./dist/component/brand/ts-chart.js"
    },
    "./drop-area": {
      "types": "./dist/component/brand/stylex/drop-area.d.ts",
      "import": "./dist/component/brand/stylex/drop-area.js"
    },
    "./component/shadcn/*": {
      "types": "./dist/component/brand/stylex/*.d.ts",
      "import": "./dist/component/brand/stylex/*.js"
    },
    "./component/brand/*": {
      "types": "./dist/component/brand/*.d.ts",
      "import": "./dist/component/brand/*.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": {
      "types": "./dist/style.css.d.ts",
      "default": "./dist/style.css"
    },
    "./theme": {
      "types": "./dist/component/brand/stylex/theme.d.ts",
      "import": "./dist/component/brand/stylex/theme.js"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "changeset": "changeset",
    "release:version": "bun changeset version && bun install --lockfile-only && bun fmt",
    "release:publish": "bun run build && bun cmd/publish-package.ts",
    "dev": "vite --config vite.config.ts",
    "catalog:build": "vite build --config vite.config.ts",
    "catalog:test": "playwright test --config playwright.config.ts",
    "boundary": "bun cmd/check-source-boundary.ts",
    "build": "bun cmd/build-package.ts",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "test": "bun test",
    "coverage:brand": "vitest run --coverage",
    "coverage:runtime": "COVERAGE_SCOPE=runtime vitest run --coverage",
    "typecheck": "bun node_modules/typescript/bin/tsc --noEmit",
    "verify:package": "bun cmd/verify-package.ts",
    "verify:tree-shaking": "bun cmd/verify-tree-shaking.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/sarabun": "^5.3.0",
    "@shadcn/react": "^0.3.1",
    "@stylexjs/stylex": "^0.19.0",
    "@tanstack/charts": "0.16.0",
    "@tanstack/react-charts": "0.16.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.5",
    "date-fns": "^4.4.0",
    "effect": "4.0.0-rc.112",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1",
    "next-themes": "^0.4.6",
    "react-day-picker": "^10.0.1",
    "react-dropzone": "^20.1.1",
    "react-resizable-panels": "^4.12.3",
    "recharts": "3.8.0",
    "sonner": "^2.0.7",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/parser": "7.29.8",
    "@changesets/cli": "2.29.8",
    "@effect/language-service": "^0.87.2",
    "@effect/tsgo": "^0.41.0",
    "@effect/vitest": "4.0.0-rc.112",
    "@playwright/test": "^1.63.0",
    "@stylexjs/unplugin": "^0.19.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/charts-data": "./internal/catalog/vendor/tanstack/data",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "latest",
    "@types/d3-array": "^3.2.2",
    "@types/d3-format": "^3.0.4",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/d3-time": "^3.0.4",
    "@types/node": "^26.4.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitest/coverage-v8": "4.1.11",
    "bun-plugin-tailwind": "^0.1.2",
    "changesets-gitlab": "0.14.0",
    "d3-array": "^3.2.4",
    "d3-format": "^3.1.2",
    "d3-geo": "^3.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "d3-time": "^3.1.0",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "playwright": "^1.55.0",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "topojson-client": "^3.1.0",
    "typescript": "^7",
    "us-atlas": "^3.0.1",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "world-atlas": "^2.0.2"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  }
}
