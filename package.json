  "scripts": {
    "changeset": "changeset",
    "release:version": "bun changeset version && bun install --lockfile-only && bun fmt",
    "release:publish": "bun run build && bun cmd/publish-package.ts",
    "release:promote": "bun run build && bun cmd/promote-release.ts",
    "dev": "vite --config vite.config.ts",
    "catalog:build": "vite build --config vite.config.ts && bun cmd/verify-catalog-bundle-size.ts",
    "catalog:test": "bun cmd/run-catalog-test.ts",
    "catalog:test:visual": "bun cmd/run-catalog-test.ts ./test/browser/visual.test.ts",
    "catalog:test:memory": "bun cmd/run-catalog-test.ts ./test/browser/memory.test.ts",
    "boundary": "bun cmd/check-source-boundary.ts",
    "build": "bun cmd/build-package.ts",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "test": "bun test",
    "coverage:brand": "vitest run --coverage",
    "coverage:runtime": "COVERAGE_SCOPE=runtime vitest run --coverage",
    "hooks:install": "git config core.hooksPath .githooks",
    "typecheck": "bun node_modules/typescript/bin/tsc --noEmit",
    "verify:package": "bun cmd/verify-package.ts",
    "verify:tree-shaking": "bun cmd/verify-tree-shaking.ts",
    "doctor": "npx react-doctor@latest"
  },
